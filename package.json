{
  "name": "anvil-code",
  "version": "0.5.3",
  "description": "An open-source coding agent that lives in your terminal",
  "type": "module",
  "license": "MIT",
  "bin": {
    "anvil": "./bin/anvil.js"
  },
  "files": [
    "bin",
    "dist",
    "web"
  ],
  "engines": {
    "node": ">=23.6.0"
  },
  "scripts": {
    "start": "node src/index.ts",
    "server": "node src/index.ts server",
    "test": "node test/smoke.ts && node test/server-smoke.ts",
    "build:publish": "tsc -p tsconfig.publish.json",
    "prepack": "npm run build:publish"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
